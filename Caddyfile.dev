{
    auto_https off
    admin off
}

:80 {
    # Frontend
    handle / {
        reverse_proxy frontend:5173
    }

    # Backend API
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Static files
    handle /static/* {
        root * /artback/staticfiles
        file_server
    }

    # Admin interface
    handle /admin/* {
        reverse_proxy backend:8000
    }
}